# =============================================================================
#  Caddy 配置：给「我的AI学习助手」自动申请并续期 HTTPS 证书。
#
#  用法：
#    1. 把本文件改名成 /etc/caddy/Caddyfile，把下面的域名换成你自己的
#    2. 域名解析：在你的域名服务商那里加一条 A 记录，指向**这台服务器**的公网 IP
#    3. sudo systemctl reload caddy
#
#  Caddy 会自动去 Let's Encrypt 申请证书、自动续期，不用你手动搞 certbot。
# =============================================================================

# ⚠️ 换成你自己的域名。必须已经解析到这台机器，否则证书申请会失败。
# 两个域名写在一个块里 —— 这样会签一张**同时覆盖 apex 和 www** 的证书。
# 只写 apex 的话，用户敲 www. 进来会看到证书错误（不是 404，是浏览器直接拦下）。
cuoti.example.com, www.cuoti.example.com {

    # 反代到本机 8000。应用那边要把 BIND_HOST 设成 127.0.0.1，
    # 这样公网直接扫 8000 是连不上的，只能走这里进来。
    reverse_proxy 127.0.0.1:8000

    # 传真实客户端 IP 给应用 —— 登录限流靠它分桶。
    # 应用的 _client_ip() 只在直连方是本机时才采信这个头，所以伪造不了。
    # （Caddy 默认就会带 X-Forwarded-For，这里写出来是为了防止以后被谁关掉）

    # 照片是孩子的作业，不该被搜索引擎收录
    header X-Robots-Tag "noindex, nofollow"

    # 上传大试卷：默认限制容易顶到
    request_body {
        max_size 50MB
    }

    # 日志（可选，出问题时有据可查）
    log {
        output file /var/log/caddy/cuoti.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# ⚠️ 这里**不要**再写一个 `:80 { ... }` 块。
# 上面那个域名块已经自动占用了 80 和 443（80 用来做 ACME 验证 + 自动跳转 HTTPS），
# 再声明一个 :80 会和它抢端口，Caddy 起不来：
#     listen tcp :80: bind: address already in use
# 想要 HTTP→HTTPS 跳转的话，Caddy 对域名块**默认就做了**，不用手写。

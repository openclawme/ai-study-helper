# =============================================================================
#  这个仓库里有些东西**绝对不能提交**，因为它们是孩子的真实数据或凭据。
#
#  ⚠️ 注意：gitignore **不支持行尾注释**。
#  写成 `password.txt   # 口令` 的话，git 会把「# 口令」也算进文件名里，
#  结果一个字都没忽略掉 —— 而且不报任何错。注释必须单独占一行。
# =============================================================================

# ---- 凭据 ----
# 泄露 = 任何人都能登录这个应用 / 伪造登录态
password.txt
.session_secret
*.env
.cuoti.env

# ---- 孩子的真实数据 ----
# static/origin 与 static/clean 是错题原图 / 去红笔图，
# 一共 30 多张孩子作业与试卷的照片。这是个人信息，推上去就收不回来了。
static/origin/
static/clean/
# AI 按具体题目生成的动画，内容同样是孩子的题目
static/anim/
# 列表缩略图：同样是孩子作业的衍生图片，绝不能提交
static/thumb/

# 全部错题记录，以及迁移前的备份
mistakes.db
mistakes.db.bak-*
*.db
*.sqlite3

# ---- 体积大、且能自动重新生成 ----
# NotoSansSC.ttf 有 17MB；main.py 里本来就有自动下载逻辑
fonts/

# ---- 常规 ----
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
*.log
nohup.out
